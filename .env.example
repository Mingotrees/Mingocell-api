# Local default is ./storage. Production default is the private school-server path
# /data/users/s22101440/mingocell-storage.
IMAGE_STORAGE_ROOT=
# Defaults: 5 GiB of original source files per owner; preserve 1 GiB free.
IMAGE_OWNER_QUOTA_BYTES=5368709120
IMAGE_MIN_FREE_BYTES=1073741824
