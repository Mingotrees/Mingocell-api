{
  "name": "mingocell-api",
  "version": "1.0.0",
  "description": "MingoCell Express API",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run build && NODE_ENV=development node --env-file-if-exists=.env dist/server.js",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env dist/cli/migrate-database.js",
    "account": "node --env-file-if-exists=.env dist/cli/manage-account.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mingotrees/Mingocell-api.git"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/Mingotrees/Mingocell-api/issues"
  },
  "homepage": "https://github.com/Mingotrees/Mingocell-api#readme",
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "typescript": "^7.0.2"
  }
}
